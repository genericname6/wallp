def build_gui():
    """Carrega o Gtk e define as classes da janela. Chamado so com interface."""
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GdkPixbuf, Gtk  # noqa: E402

    def paintable(pb):
        if pb is None:
            return None
        try:
            return Gdk.Texture.new_for_pixbuf(pb)
        except GLib.Error:
            return None

    def pad(w, top=0, bottom=0, start=0, end=0):
        w.set_margin_top(top)
        w.set_margin_bottom(bottom)
        w.set_margin_start(start)
        w.set_margin_end(end)
        return w

    class ClockIcon(Gtk.DrawingArea):
        """Relogio de verdade: circulo, 12 marcas e um ponteiro que gira.

        O ponteiro completa uma volta por intervalo de rotacao -- assim ele
        mostra o progresso da contagem, em vez de girar sem relacao com nada.
        """

        def __init__(self, size=26):
            super().__init__()
            self.progress = 0.0
            self.active = False
            self.set_size_request(size, size)
            self.add_css_class("clock")
            self.set_draw_func(self._draw)

        def set_state(self, active, progress=0.0):
            self.active = active
            self.progress = progress
            self.queue_draw()

        def clock_color(self, ctx):
            """Cor real do widget, para o relogio existir em qualquer tema.

            Gtk.Widget.get_color() devolve o foreground e respeita o tema
            claro e o escuro. lookup_color() esta deprecado. O nome e
            clock_color, e nao get_color, para nao colidir com a API.
            """
            try:
                rgba = Gtk.Widget.get_color(self, ctx)
                if rgba is not None:
                    return (rgba.red, rgba.green, rgba.blue)
            except Exception:  # noqa: BLE001
                pass
            return (0.13, 0.13, 0.13)   # fallback: quase preto (tema claro)

        def _draw(self, area, ctx, w, h):
            # A cor vem do CSS do widget (color: currentColor) e nao branco
            # fixo: no tema claro do GNOME o branco sumia no fundo branco.
            col = self.clock_color(ctx)
            cx, cy, r = w / 2, h / 2, min(w, h) / 2 - 1.5
            dim = 0.45 if not self.active else 1.0

            ctx.set_line_width(1.3)
            ctx.set_source_rgba(*col, 0.75 * dim)
            ctx.arc(cx, cy, r, 0, 2 * math.pi)
            ctx.stroke()

            for i in range(12):
                a = i * math.pi / 6 - math.pi / 2
                inner = r * (0.80 if i % 3 == 0 else 0.88)
                ctx.set_line_width(1.5 if i % 3 == 0 else 1.0)
                ctx.move_to(cx + inner * math.cos(a), cy + inner * math.sin(a))
                ctx.line_to(cx + r * 0.97 * math.cos(a), cy + r * 0.97 * math.sin(a))
            ctx.stroke()

            ang = self.progress * 2 * math.pi - math.pi / 2
            ctx.set_line_width(2.0)
            ctx.set_source_rgba(*col, 0.95 if self.active else 0.55)
            ctx.move_to(cx, cy)
            ctx.line_to(cx + r * 0.72 * math.cos(ang), cy + r * 0.72 * math.sin(ang))
            ctx.stroke()
            ctx.arc(cx, cy, 1.6, 0, 2 * math.pi)
            ctx.fill()

    class Row(Gtk.ListBoxRow):
        """Linha da lista. O item fica em .item."""

        def __init__(self, pixbuf, title, subtitle, badge):
            super().__init__()
            self.item = None
            self.set_activatable(True)

            box = pad(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12),
                      top=6, bottom=6, start=8, end=8)

            img = Gtk.Picture()
            if (tex := paintable(pixbuf)) is not None:
                img.set_paintable(tex)
            img.set_content_fit(Gtk.ContentFit.COVER)
            img.set_size_request(THUMB_W, THUMB_H)
            img.add_css_class("card")
            box.append(img)

            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            txt.set_hexpand(True)
            txt.set_valign(Gtk.Align.CENTER)
            lbl = Gtk.Label(label=title)
            lbl.set_xalign(0)
            lbl.set_ellipsize(3)
            sub = Gtk.Label(label=subtitle)
            sub.set_xalign(0)
            sub.add_css_class("dim-label")
            txt.append(lbl)
            txt.append(sub)
            box.append(txt)

            if badge:
                b = Gtk.Label(label=badge)
                b.add_css_class("bd")
                b.add_css_class(badge)
                b.set_valign(Gtk.Align.CENTER)
                box.append(b)

            self.set_child(box)

    class GridCell(Gtk.Overlay):
        """Celula da grade: so a imagem em 9:21, com o badge sobreposto.

        E um Overlay (nao um Box) pra nao aninhar: assim o Picture e o filho
        direto e o tamanho pedido cai na imagem, que e o que importa.
        """

        def __init__(self, pixbuf, badge):
            super().__init__()
            self.item = None

            self.img = Gtk.Picture()
            if (tex := paintable(pixbuf)) is not None:
                self.img.set_paintable(tex)
            # COVER = preenche a celula toda e corta o excesso, sem distorcer
            self.img.set_content_fit(Gtk.ContentFit.COVER)
            self.img.set_can_shrink(True)
            self.set_child(self.img)

            if badge:
                b = Gtk.Label(label=badge)
                b.add_css_class("bd")
                b.add_css_class(badge)
                b.set_halign(Gtk.Align.END)
                b.set_valign(Gtk.Align.START)
                b.set_margin_top(4)
                b.set_margin_end(4)
                self.add_overlay(b)

            self.add_css_class("gridcell")

        def set_pixbuf(self, pb):
            if (tex := paintable(pb)) is not None:
                self.img.set_paintable(tex)

