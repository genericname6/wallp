            self.spin.set_numeric(True)
            self.spin.set_width_chars(5)
            self.unit_dd = Gtk.DropDown.new_from_strings(["segundos", "minutos"])
            self.unit_dd.set_halign(Gtk.Align.START)
            self.spin.connect("value-changed", self.on_interval_changed)
            self.unit_dd.connect("notify::selected", self.on_interval_changed)
            tbox.append(Gtk.Label(label="a cada"))
            tbox.append(self.spin)
            tbox.append(self.unit_dd)
            box.append(tbox)

            self.countdown = Gtk.Label(label="")
            self.countdown.add_css_class("dim-label")
            self.countdown.set_margin_start(24)
