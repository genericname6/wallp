        # ---------------- popup do relogio
        def build_popover(self):
            pop = Gtk.Popover()

            box = pad(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8),
                      top=12, bottom=12, start=12, end=12)

