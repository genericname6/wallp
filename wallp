def _systemctl(*args):
    """systemctl --user, devolvendo (ok, saida). Nao levanta se nao existir."""
    try:
        r = subprocess.run(["systemctl", "--user", *args],
                           capture_output=True, text=True, timeout=20)
        return r.returncode == 0, (r.stdout + r.stderr).strip()
    except (FileNotFoundError, subprocess.SubprocessError, OSError) as e:
        return False, str(e)


def boot_enable(cfg):
    """Instala a rotacao no boot. So grava boot=True se deu certo.

    Antes, gravava True mesmo com o systemd fora do ar ou sem systemctl no
    PATH, e o checkbox ficava marcado sem nada instalado -- a UI mentia.
    """
    if not shutil.which("systemctl"):
        raise RuntimeError("systemctl nao encontrado: instale o systemd ou use --status")

    UNIT_DIR.mkdir(parents=True, exist_ok=True)
    UNIT_FILE.write_text(UNIT)
    ok, out = _systemctl("daemon-reload")
    if not ok:
        raise RuntimeError(f"systemd indisponivel: {out[:120]}")

    ok, out = _systemctl("enable", "--now", "wallp.service")
    if not ok:
        raise RuntimeError(f"falha ao habilitar: {out[:160]}")

    # linger faz o service subir no boot mesmo sem sessao grafica aberta
    if shutil.which("loginctl"):
        subprocess.run(["loginctl", "enable-linger", os.environ.get("USER", "")],
                       capture_output=True)

    cfg["boot"] = True
    save_config(cfg)
    return True


def boot_disable(cfg):
    _systemctl("disable", "--now", "wallp.service")
    try:
        UNIT_FILE.unlink()
    except OSError:
        pass
    _systemctl("daemon-reload")
    cfg["boot"] = False
    save_config(cfg)
    return True


def boot_status():
    ok, out = _systemctl("is-enabled", "wallp.service")
    if not ok:
        return out.splitlines()[0][:60] if out else "indisponivel"
    return out.strip() or "desconhecido"


# --------------------------------------------------------------------------- modo headless

def run_headless(cfg):
    """Sem janela, sem Gtk: daemon de rotacao (~27 MB)."""
    rot = Rotator(cfg["folder"], cfg["interval"])
    rot.rescan()
    if not rot.files:
        # sai com 0, nao 1: pasta vazia e um estado legitimo, e o
        # Restart=on-abnormal do unit nao entra em loop por causa disso.
        # Fica de vigia: a pasta pode ser preenchida depois (disco montado,
        # pasta criada por outro app) e a rotacao comeca sozinha.
        print(f"wallp: pasta sem imagens ainda: {cfg['folder'] or '(vazia)'}"
              f" — reavaliando a cada 60 s", file=sys.stderr)

        def vigiar():
            rot.rescan()
            if rot.files:
                print(f"wallp: {len(rot.files)} imagem(ns) apareceram,"
                      f" rotando a cada {human_time(rot.interval)}", file=sys.stderr)
                rot.on_apply = lambda f: print(f"  -> {f.name}")
                rot.start()
                return False          # sai do vigia
            return True               # continua de olho

        GLib.timeout_add_seconds(60, vigiar)
        GLib.MainLoop().run()
        return 0
    print(f"wallp: rotando {len(rot.files)} imagens de {cfg['folder']} "
          f"a cada {human_time(rot.interval)}")

    def on_apply(f):
        print(f"  -> {f.name}")

    rot.on_apply = on_apply
    rot.start()
    GLib.MainLoop().run()
    return 0


