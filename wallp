# --------------------------------------------------------------------------- fontes

def scan_folder(folder):
    """Imagens da pasta local, ordenadas. [] se nao houver."""
    p = pathlib.Path(folder).expanduser()
    if not p.is_dir():
        return []
    try:
        return sorted(f for f in p.iterdir() if f.is_file() and f.suffix.lower() in IMG_EXT)
    except OSError:
        return []


def fetch_web(key, timeout=20):
    """Busca wallpapers 18+ e filtra no cliente. Um pedido por tier, mesclados."""
    if not key:
        raise RuntimeError("sem API key (wallp --key, ou WALLP_KEY)")
    vistos, out = set(), []

    def get(tier):
        qs = urllib.parse.urlencode(
            {"purity": tier, "sorting": "random", "apikey": key}
        )
        req = urllib.request.Request(f"{API}?{qs}", headers={"User-Agent": "wallp/1.0"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read()).get("data") or []

    def collect(items):
        for w in items:
            wid = w.get("id")
            if not wid or wid in vistos:
                continue
            if w.get("purity") not in PURITY_18PLUS:  # filtro 18+ real
                continue
            vistos.add(wid)
            out.append(w)

    for tier in PURITY_PEDIDO:
        try:
            collect(get(tier))
        except (urllib.error.URLError, ValueError, TimeoutError):
            continue
    return out


def thumb_path(w):
    return CACHE_DIR / f"{w['id']}.jpg"


def local_thumb_path(f):
    """Cache em disco da miniatura local, invalido por mtime+bytes.

    Decodificar as 29 imagens da pasta mede 7,1 s (sao PNG de ate 15 MB /
    5120x2880). Guardar a versao 96px como JPEG faz a segunda abertura ser
    quase instantanea, sem depender de o PNG continuar no mesmo lugar.
    """
    try:
        st = f.stat()
        key = f"{f.stat().st_mtime_ns}-{st.st_size}"
    except OSError:
        return None
    h = __import__("hashlib").sha1(
        (str(f) + key).encode("utf-8", "replace")).hexdigest()[:20]
    return CACHE_DIR / "local" / f"{h}.jpg"


def fetch_thumb(w):
    dest = thumb_path(w)
    if dest.exists() and dest.stat().st_size > 1000:
        return dest
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    wid = w["id"]
    url = THUMB.format(p=wid[:2], i=wid)
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "wallp/1.0"})
        with urllib.request.urlopen(req, timeout=15) as r:
            dest.write_bytes(r.read())
    except (urllib.error.URLError, TimeoutError, OSError):
        return None
    return dest


def fetch_full(w):
    dest = CACHE_DIR / f"{w['id']}{pathlib.Path(w['path']).suffix}"
    if dest.exists() and dest.stat().st_size > 1000:
        return dest
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    req = urllib.request.Request(
        w["path"], headers={"User-Agent": "wallp/1.0", "Referer": "https://wallhaven.cc/"}
    )
    with urllib.request.urlopen(req, timeout=180) as r:
        dest.write_bytes(r.read())
    return dest


# --------------------------------------------------------------------------- aplicar

def set_wallpaper(path):
    """Aplica no GNOME (claro e escuro). Nao mexe em picture-options."""
    uri = pathlib.Path(path).resolve().as_uri()
    for key in ("picture-uri", "picture-uri-dark"):
        subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.background", key, uri],
            check=True, capture_output=True,
        )


# --------------------------------------------------------------------------- rotacao

def human_time(sec):
    sec = max(0, int(sec))
    m, s = divmod(sec, 60)
    h, m = divmod(m, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


class Rotator:
    """Troca o wallpaper da pasta a cada N segundos. So a pasta -- nada de rede.

    Quando `interval <= 0` nao agenda nada: a unica troca e a do proximo(),
    feita na mao. Isso mantem o timer do GLib sem dangling em uso manual.
    """

    def __init__(self, folder, interval, on_apply=None, on_tick=None):
        self.folder = folder
        self.interval = max(0, int(interval))
        self.on_apply = on_apply
        self.on_tick = on_tick
        self.files = []
        self.index = -1
        self.active = False
        self.remaining = 0
        self._tid = None

    # -- estado ------------------------------------------------------------
    def available(self):
        return bool(self.files)

    def current(self):
        return self.files[self.index] if 0 <= self.index < len(self.files) else None

    def next_name(self):
        if not self.files:
            return None
        return self.files[(self.index + 1) % len(self.files)].name

    def rescan(self):
        self.files = scan_folder(self.folder)

    # -- controle ----------------------------------------------------------
    def set_interval(self, sec):
        self.interval = max(0, int(sec))
        if self.active:
            self.restart_timer()

    def start(self):
        self.rescan()
        if not self.files:
            return False
        self.active = True
        self.restart_timer()
        return True

    def stop(self):
        self.active = False
        self.cancel_timer()
        self.remaining = 0
        self._emit_tick()

    def toggle(self):
        if self.active:
            self.stop()
            return False
        return self.start()

    def cancel_timer(self):
        if self._tid is not None:
            GLib.source_remove(self._tid)
            self._tid = None

    def restart_timer(self):
        self.cancel_timer()
        if not self.active or self.interval <= 0:
            return
        self.remaining = self.interval
        self._tid = GLib.timeout_add_seconds(1, self._tick)
        self._emit_tick()

    # -- laco --------------------------------------------------------------
    def _tick(self):
        self.remaining -= 1
        if self.remaining <= 0:
            self.remaining = self.interval if self.interval > 0 else 0
            self.advance()
        self._emit_tick()
        return self.active and self.interval > 0

    def _emit_tick(self):
        if self.on_tick:
            self.on_tick(self)

    def advance(self):
        """Aplica o proximo da pasta. Devolve o nome aplicado, ou None."""
        if not self.files:
            return None
        self.index = (self.index + 1) % len(self.files)
        f = self.files[self.index]
        try:
            set_wallpaper(f)
        except (subprocess.CalledProcessError, OSError):
            return None
        if self.on_apply:
            self.on_apply(f)
        return f.name

    def next(self):
        """Troca manual: resorteia a lista e aplica."""
        if self.active:
            self.restart_timer()
        return self.advance()


# --------------------------------------------------------------------------- systemd

UNIT = """[Unit]
Description=wallp - rotacao automatica de wallpaper
Documentation=file://%h/.local/share/wallp/README.md

[Service]
Type=simple
ExecStart=%h/.local/bin/wallp --rotate
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
"""


def boot_enable(cfg):
    UNIT_DIR.mkdir(parents=True, exist_ok=True)
    UNIT_FILE.write_text(UNIT)
    subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "wallp.service"],
                   capture_output=True)
    # linger faz o service subir no boot mesmo sem sessao grafica aberta
    subprocess.run(["loginctl", "enable-linger", os.environ.get("USER", "")],
                   capture_output=True)
    cfg["boot"] = True
    save_config(cfg)
    return True


def boot_disable(cfg):
    subprocess.run(["systemctl", "--user", "disable", "--now", "wallp.service"],
                   capture_output=True)
    try:
        UNIT_FILE.unlink()
    except OSError:
        pass
    cfg["boot"] = False
    save_config(cfg)
    return True


def boot_status():
    r = subprocess.run(["systemctl", "--user", "is-enabled", "wallp.service"],
                       capture_output=True, text=True)
    return r.stdout.strip() or "desconhecido"


# --------------------------------------------------------------------------- modo headless

def run_headless(cfg):
    """Sem janela, sem Gtk: daemon de rotacao (~27 MB)."""
    rot = Rotator(cfg["folder"], cfg["interval"])
    rot.rescan()
    if not rot.files:
        print(f"wallp: pasta sem imagens: {cfg['folder'] or '(vazia)'}", file=sys.stderr)
        return 1
    print(f"wallp: rotando {len(rot.files)} imagens de {cfg['folder']} "
          f"a cada {human_time(rot.interval)}")

    def on_apply(f):
        print(f"  -> {f.name}")

    rot.on_apply = on_apply
    rot.start()
    GLib.MainLoop().run()
    return 0


