        def _restore_interval(self):
            unit = self.cfg.get("unit", "s")
            iv = self.cfg.get("interval", 300)
            if unit == "min":
                self.unit_dd.set_selected(1)
                self.spin.set_value(max(1, iv // 60))
            else:
                self.unit_dd.set_selected(0)
                self.spin.set_value(max(1, min(iv, 1440)))

        # ---------------- status / sync
        def say(self, msg, warn=False):
            self.status.set_label(msg)
            self.status.remove_css_class("warning")
            if warn:
                self.status.add_css_class("warning")

        def sync_rotate_ui(self):
            on = self.rotator.active
            self.chk_rotate.set_active(on)
            self.chk_boot.set_active(bool(self.cfg.get("boot")))
            self.chk_rotate.set_sensitive(self.rotator.available())
            n = len(self.rotator.files)
            if n:
                self.rot_info.set_text(f"{n} imagem(ns) na pasta · proxima: "
                                       f"{self.rotator.next_name() or '-'}")
            else:
                self.rot_info.set_text("pasta sem imagens: nada para rotacionar")
            self.on_rot_tick(self.rotator)

        def on_rot_tick(self, rot):
            if rot.active and rot.interval > 0:
                prog = 1 - (rot.remaining / rot.interval)
                self.clock.set_state(True, prog)
                self.countdown.set_text(f"proxima em {human_time(rot.remaining)}")
            elif rot.active:
                self.clock.set_state(True, 0.0)
                self.countdown.set_text("intervalo 0: aplica na mao (N)")
            else:
                self.clock.set_state(False, 0.0)
                self.countdown.set_text("rotacao parada")

        def on_rotated(self, f):
            GLib.idle_add(self.say, f"rotado: {f.name}")
            GLib.idle_add(self.sync_rotate_ui)

        # ---------------- handlers
        def on_rotate_toggle(self, btn):
            if btn.get_active() != self.rotator.active:
                self.rotator.toggle()
            self.cfg["rotate"] = self.rotator.active
            save_config(self.cfg)
            self.sync_rotate_ui()

        def on_interval_changed(self, *_):
            v = self.spin.get_value()
            secs = int(v * 60) if self.unit_dd.get_selected() == 1 else int(v)
            self.cfg["interval"] = max(1, secs)
            self.cfg["unit"] = "min" if self.unit_dd.get_selected() == 1 else "s"
            save_config(self.cfg)
            self.rotator.set_interval(max(1, secs))
            self.on_rot_tick(self.rotator)

        def on_boot_toggle(self, btn):
            if btn.get_active():
                boot_enable(self.cfg)
            else:
                boot_disable(self.cfg)
            self.say(f"boot: {boot_status()}")

        def on_next(self):
            if not self.rotator.files:
                self.say("pasta sem imagens", warn=True)
                return
            # atalho explicito de rotacao: nao desliga a rotacao
            name = self.rotator.next()
            self.say(f"aplicado: {name}" if name else "falhou", warn=name is None)

        def on_view_toggle(self, btn):
            mode = "grid" if btn.get_active() else "list"
            if mode == self.stack.get_visible_child_name():
                return
            self.cfg["view"] = mode
            save_config(self.cfg)
            self.stack.set_visible_child_name(mode)   # rebuild le o modo novo
            self.rebuild()

        def rebuild(self):
            """Redesenha tudo no container do modo atual.

            Inverter o Stack sozinho nao move nada: cada item foi criado num
            ListBox ou num Grid conforme o modo da hora. Entao juntamos tudo
            Numa lista unica, limpamos e recriamos.

            A ordem de exibicao e sempre local -> web, independente do modo.
            """
            # junta tudo sem repetir: o mesmo item pode estar em rows E em
            # grid_items se algum caminho antigo nao limpou
            merged, seen = [], set()
            for src in (list(self.rows.values()) + list(self.grid_items.values())):
                if id(src) not in seen:
                    seen.add(id(src))
                    merged.append(src)

            ordered = ([i for i in merged if i["kind"] == "local"]
                       + [i for i in merged if i["kind"] == "web"])

            self.clear()
            for it in ordered:
                badge = it.get("badge") or None
                if it["kind"] == "local":
                    badge = None
                self.add_item(self._pix_for(it), it.get("label", ""),
                              it.get("sub", ""), badge, it)
            if self.stack.get_visible_child_name() == "grid":
                self.resize_grid()      # posiciona tudo de uma vez
            return len(ordered)

        def on_key(self, _c, keyval, _k, _m, _state=None):
            if keyval in (ord("R"), ord("r")):
                self.load_web()
            elif keyval in (ord("V"), ord("v")):
                self.view_btn.set_active(not self.view_btn.get_active())
            elif keyval in (ord("N"), ord("n")):
                self.on_next()
            elif keyval == ord("q") and _m & 4:  # Ctrl+Q
                self.quit_app()
            else:
                return False
            return True

        def quit_app(self):
            self.rotator.stop()
            if self._tray:
                GLib.idle_add(self._tray.hide)
            self.get_application().quit()

        def on_close(self, *_):
            # fechar esconde em vez de sair, para a rotacao continuar
            if self.cfg.get("rotate") or self._tray:
                self.say("fechado, mas a rotacao continua · rode  wallp  para reabrir")
                self.set_visible(False)
                self._show_tray()
                return True
            self.quit_app()
            return False

        # ---------------- bandeja
        def _show_tray(self):
            if not self._tray:
                try:
                    gi.require_version("AppIndicator3", "0.1")
                    from gi.repository import AppIndicator3 as AI
                except (ValueError, ImportError):
                    return
                # o mesmo icone colorido da janela; a bandeja cai no
                # preferences-system-time-symbolic so se o SVG nao for encontrado
                icon = ICON_NAME
                if not Gtk.IconTheme.get_default().has_icon(icon):
                    icon = "preferences-system-time-symbolic"
                ind = AI.Indicator.new("wallp", icon,
                                       AI.IndicatorCategory.APPLICATION_STATUS)
                m = Gtk.Menu()
                it = Gtk.MenuItem(label="Mostrar wallp")
                it.connect("activate", lambda *_: self.get_application().activate())
                m.append(it)
                n = Gtk.MenuItem(label="Proximo wallpaper")
                n.connect("activate", lambda *_: self.on_next())
                m.append(n)
                m.append(Gtk.SeparatorMenuItem())
                c = Gtk.CheckMenuItem(label="Trocar automaticamente")
                c.set_active(self.rotator.active)
                c.connect("toggled", lambda w: (self.chk_rotate.set_active(w.get_active()), False)[1])
                m.append(c)
                m.append(Gtk.SeparatorMenuItem())
                q = Gtk.MenuItem(label="Sair")
                q.connect("activate", lambda *_: self.quit_app())
                m.append(q)
                m.show_all()
                ind.set_menu(m)
                self._tray = ind
            self._tray.set_status("wallp")

            # ---------------- lista / grade
        def clear(self):
            for row in self.rows:
                self.listbox.remove(row)
            for cell in self.grid_items:
                self.grid.remove(cell)
            self.rows.clear()
            self.grid_items.clear()
            self.web_refs.clear()
            self._pending.clear()
            self._ncols = GRID_COLS_DEFAULT

        def _relayout(self):
            """Posiciona as celulas pendentes em linhas de _ncols.

            Como as colunas sao responsivas, nao da pra fixar a posicao no
            attach: cada celula nova ou uma mudanca de largura tem que
            reposicionar todas.
            """
            n = self._ncols
            order = list(self.grid_items)          # ordem de insercao = ordem visual
            for cell in self._pending:
                if cell not in self.grid_items:
                    continue
                pos = order.index(cell)
                self.grid.attach(cell, pos % n, pos // n, 1, 1)
            self._pending.clear()

        def clear_web(self):
            """Remove so as celulas/linhas da web, preservando as locais."""
            if not self.web_refs:
                return
            # na grade qualquer remocao desloca as posicoes: reconstroi
            if self.stack.get_visible_child_name() == "grid":
                self.rebuild()
                return
            for widget, _c in self.web_refs:
                self.listbox.remove(widget)
                self.rows.pop(widget, None)
            self.web_refs.clear()

        def add_header(self, text):
            self.listbox.append(Header(text))

        def add_item(self, pixbuf, title, subtitle, badge, item):
            """Coloca o item no container visivel e o registra.

            title/subtitle/badge sao guardados no proprio item para que o
            rebuild (troca lista<->grade) nao perca o texto.
            """
            item["label"] = title
            item["sub"] = subtitle
            item["badge"] = badge
            if pixbuf is not None:
                item["_pb"] = pixbuf      # sobrevive a troca lista<->grade
            if self.stack.get_visible_child_name() == "grid":
                cell = GridCell(pixbuf, badge)
                cell.item = item
                self._pending.append(cell)      # posicionado no fim, por _relayout
                self.grid_items[cell] = item
                if item["kind"] == "web":
                    self.web_refs.append((cell, self.grid))
                return cell
            row = Row(pixbuf, title, subtitle, badge)
            row.item = item
            self.listbox.append(row)
            self.rows[row] = item
            if item["kind"] == "web":
                self.web_refs.append((row, self.listbox))
            return row

        def resize_grid(self):
            """Celulas em 21:9 (mais larga que alta), colunas responsivas.

            Primeiro decide quantas colunas cabem na largura, depois encolhe
            a celula (em largura e altura, sempre no 21:9) ate caberem as
            linhas que cabem na altura. Isso evita a rolagem enorme.
            """
            # a largura real da grade. usar self.scroll.get_width() dava o
            # minimo do clamp (160) enquanto a janela nao estava alocada, e a
            # grade ficava com 4 colunas de 124px num monitor de 1900px
            avail_w = max(160, (self.get_width() or 0) - 40)
            avail_h = max(120, (self.get_height() or 0) - 190)
            n = len(self.grid_items)
            if not n:
                return 0, 0, 0

            # Heuristica: usa a largura toda, mas sem celulas gigantes.
            # Sobe de colunas enquanto a celula ficar grande o bastante para
            # o wallpaper ser reconhecivel; a ultima coluna que cabe E a que
            # vence. Com GRID_CELL_MAX como teto, para nao sobrar vao vazio.
            ncols = 2
            cw = (avail_w - 6) / 2
            for c in range(2, GRID_COLS_MAX + 1):
                cand = (avail_w - (c - 1) * 6) / c
                if cand < GRID_CELL_MIN:
                    break                       # pequena demais: para aqui
                if cand > GRID_CELL_MAX:
                    continue                    # ainda cabe mais gente
                ncols, cw = c, cand
            cw = min(cw, GRID_CELL_MAX)
            # se a melhor celula ainda for enorme, preferimos 1 coluna a mais
            # em vez de deixar metade da tela vazia
            while ncols < GRID_COLS_MAX and cw > GRID_CELL_MAX:
                ncols += 1
                cw = min(cw, (avail_w - (ncols - 1) * 6) / ncols)
            ch = int(cw / GRID_RATIO)

            for cell in self.grid_items:
                cell.set_size_request(int(cw), ch)
            self._ncols = ncols
            self._relayout()                      # reposiciona com o ncols novo
            return ncols, int(cw), ch

        # -- local
        def load_local(self, folder):
            files = scan_folder(folder)
            if not files:
                return 0
            self.add_header(f"Local  ·  {len(files)} imagem(ns) em {folder}")
            for f in files:
                item = {"kind": "local", "path": str(f)}
                pb = self._load_local(f)          # cache de disco; None = decodifica depois
                if pb is not None:
                    item["_pb"] = pb
                else:
                    POOL.submit(self._local_worker, f, item)
                try:
                    kb = f.stat().st_size // 1024
                except OSError:
                    kb = 0
                self.add_item(pb, f.name, f"{kb} KB", None, item)
            return len(files)

        def _load_local(self, f):
            """Miniatura local do cache em disco, ou None se ainda nao existe."""
            p = local_thumb_path(f)
            if p is None or not p.exists():
                return None
            try:
                return GdkPixbuf.Pixbuf.new_from_file_at_scale(str(p), THUMB_W, THUMB_H, True)
            except GLib.Error:
                return None

        def _local_worker(self, f, item):
            """Decodifica fora da thread da UI e grava o cache de disco."""
            p = local_thumb_path(f)
            pb = self._decode_local(f, p)
            if pb is None:
                return
            GLib.idle_add(self._set_item_thumb, id(item), pb)

        def _decode_local(self, f, dest):
            """Abre a imagem local, com fallback quando o glycin recusa.

            O glycin (loader do GNOME 50) falha em alguns PNGs 5120x2880 com
            "InternalEditorError" -- 10 das 29 imagens da pasta. Nesses casos
            o ImageMagick gera a miniatura, que e so 4 KB.
            """
            if dest is not None:
                dest.parent.mkdir(parents=True, exist_ok=True)
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(f), THUMB_W, THUMB_H, True)
                if dest is not None and not dest.exists():
                    pb.savev(str(dest), "jpeg", [], [])
                return pb
            except GLib.Error:
                pass

            # fallback: imagem magick
            if dest is None:
                return None
            tool = next((t for t in ("magick", "convert")
                         if __import__("shutil").which(t)), None)
            if not tool:
                return None
            try:
                subprocess.run(
                    [tool, str(f), "-resize", f"{THUMB_W}x{THUMB_H}", str(dest)],
                    capture_output=True, timeout=60, check=True)
            except (subprocess.SubprocessError, OSError):
                return None
            try:
                return GdkPixbuf.Pixbuf.new_from_file_at_scale(str(dest), THUMB_W, THUMB_H, True)
            except GLib.Error:
                return None

        # -- web
        def load_web(self):
            self.clear_web()
            key = self.entry_key()
            if not key:
                self.say("sem API key: use  wallp --key <APIKEY>  ou  WALLP_KEY", warn=True)
                return
            self.say("buscando wallpapers 18+ no wallhaven...")
            threading.Thread(target=self._web_worker, args=(key,), daemon=True).start()

        def entry_key(self):
            return load_config().get("key", "")

        def _web_worker(self, key):
            try:
                GLib.idle_add(self._web_done, fetch_web(key), None)
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self._web_done, [], str(e))

        def _web_done(self, data, err):
            if err:
                self.say(f"web: {err}", warn=True)
                return False
            if not data:
                self.say("web: nenhum 18+ retornou", warn=True)
                return False

            if self.stack.get_visible_child_name() == "list":
                self.add_header(f"Wallhaven 18+  ·  {len(data)} wallpaper(s)")
            for w in data:
                item = {"kind": "web", "w": w}
                w["_item_ref"] = item          # o worker acha o item por ele
                pb = self._load_thumb(w)
                if pb is None:
                    POOL.submit(self._thumb_worker, w)
                self.add_item(pb, w["id"],
                              f"{w.get('resolution', '?')} · {w.get('file_size', 0) // 1024} KB",
                              w.get("purity", ""), item)
            if self.stack.get_visible_child_name() == "grid":
                self.resize_grid()
            n_sfw = sum(1 for w in data if w["purity"] == "nsfw")
            self.say(f"{len(data)} da web ({n_sfw} nsfw, {len(data) - n_sfw} sketchy)"
                     f" · R sorteia · V troca a view")
            return False

        def _load_thumb(self, w):
            tp = thumb_path(w)
            if not tp.exists():
                return None
            try:
                return GdkPixbuf.Pixbuf.new_from_file_at_scale(str(tp), THUMB_W, THUMB_H, True)
            except GLib.Error:
                return None

        def _thumb_worker(self, w):
            p = fetch_thumb(w)
            if not p:
                return
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(p), THUMB_W, THUMB_H, True)
            except GLib.Error:
                return
            GLib.idle_add(self._set_item_thumb, id(w.get("_item_ref")), pb)

        def _set_item_thumb(self, item_id, pb):
            """Pinta a miniatura assim que ela chega, sem travar a UI."""
            for widget, item in {**self.rows, **self.grid_items}.items():
                if id(item) == item_id:
                    item["_pb"] = pb
                    if isinstance(widget, GridCell):
                        widget.set_pixbuf(pb)
                    else:
                        widget.get_child().get_first_child().set_paintable(paintable(pb))
                    break
            return False

        # -- acoes
        def load(self):
            folder = self.entry.get_text().strip()
            self.cfg["folder"] = folder
            save_config(self.cfg)
            self.clear()

            n_local = self.load_local(folder)
            self.say(f"{n_local} local(is)" if n_local else "pasta vazia ou invalida: so a web")

            self.rotator.folder = folder
            self.rotator.rescan()
            self.sync_rotate_ui()
            if self.rotator.active and not self.rotator.files:
                self.rotator.stop()
                self.cfg["rotate"] = False
                save_config(self.cfg)

            self.load_web()

        def on_activate(self, _lb, row):
            if item := self.rows.get(row):
                self.apply(item)

        def on_grid_click(self, gesture, n_press, x, y):
            if n_press != 1:
                return
            target = self.grid.pick(x, y, Gtk.PickFlags.DEFAULT)
            if item := self.grid_items.get(target):
                self.apply(item)

        def _pix_for(self, item):
            """Pixbuf do item. Fica preso ao proprio item, entao sobrevive a
            varias trocas de lista<->grade.

            Sem isso, cada clique redecodifica ~30 PNGs de ate 15 MB na thread
            da UI: 7,2 s de congelamento medidos, agora ~0,03 s.
            """
            pb = item.get("_pb")
            if pb is not None:
                return pb
            if item["kind"] == "local":
                pb = self._load_local(pathlib.Path(item["path"]))
                if pb is None:
                    POOL.submit(self._local_worker, pathlib.Path(item["path"]), item)
                    return None
            else:
                pb = self._load_thumb(item["w"])
                if pb is None:
                    POOL.submit(self._thumb_worker, item["w"])
            if pb is not None:
                item["_pb"] = pb
            return pb

        def apply(self, item):
            # escolha manual tem prioridade: se a rotacao estava ligando, ela
            # desliga de vez, senao o proximo tick sobrescreveria o clique
            if self.rotator.active:
                self.rotator.stop()
                self.cfg["rotate"] = False
                save_config(self.cfg)
                self.sync_rotate_ui()
                GLib.idle_add(self.say, "rotacao desligada (escolha manual)")
            if item["kind"] == "local":
                threading.Thread(target=self._apply_local, args=(item["path"],),
                                 daemon=True).start()
            else:
                threading.Thread(target=self._apply_web, args=(item["w"],),
                                 daemon=True).start()

        def _apply_local(self, path):
            GLib.idle_add(self.say, f"aplicado: {pathlib.Path(path).name}")
            try:
                set_wallpaper(path)
            except (subprocess.CalledProcessError, OSError) as e:
                GLib.idle_add(self.say, f"falhou: {e}", True)

        def _apply_web(self, w):
            GLib.idle_add(self.say, f"baixando {w['id']}...")
            try:
                dest = fetch_full(w)
                GLib.idle_add(self.say, f"aplicado: {dest.name}")
                set_wallpaper(dest)
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self.say, f"falhou: {e}", True)

        def do_size_allocate(self, *a):  # noqa: N802
            # recalcula quando a largura REAL da janela muda. medir o
            # ScrolledWindow dava valor velho/temporario e a grade travava
            # num tamanho errado (so 4 colunas num monitor largo)
            if self.stack.get_visible_child_name() == "grid":
                w = self.get_width()
                if w and abs(w - self._width) > 8:
                    self._width = w
                    self.resize_grid()
            Gtk.ApplicationWindow.do_size_allocate(self, *a)

    return Win


