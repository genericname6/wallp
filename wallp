def scan_folder(folder):
    """Imagens da pasta local, ordenadas. [] se nao houver."""
    p = pathlib.Path(folder).expanduser()
    if not p.is_dir():
        return []
    try:
        return sorted(f for f in p.iterdir() if f.is_file() and f.suffix.lower() in IMG_EXT)
    except OSError:
        return []


def fetch_web(key, timeout=20):
    """Busca wallpapers 18+ e filtra no cliente. Um pedido por tier, mesclados."""
    if not key:
        raise RuntimeError("sem API key (wallp --key, ou WALLP_KEY)")
    vistos, out = set(), []
    falhas = []

    def get(tier):
        qs = urllib.parse.urlencode(
            {"purity": tier, "sorting": "random", "apikey": key}
        )
        req = urllib.request.Request(f"{API}?{qs}", headers={"User-Agent": "wallp/1.0"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read()).get("data") or []

    def collect(items):
        for w in items:
            wid = w.get("id")
            if not wid or wid in vistos:
                continue
            if w.get("purity") not in PURITY_18PLUS:  # filtro 18+ real
                continue
            vistos.add(wid)
            out.append(w)

    for tier in PURITY_PEDIDO:
        try:
            collect(get(tier))
        except urllib.error.HTTPError as e:
            falhas.append(f"HTTP {e.code}")
        except (urllib.error.URLError, ValueError, TimeoutError) as e:
            falhas.append(type(e).__name__)

    # todas as requisicoes falharam != a API respondeu e nao tinha 18+.
    # O texto inclui o codigo HTTP e sugere retry: 403 aqui e bloqueio
    # temporario do wallhaven, NAO key invalida (key invalida da 401).
    if falhas and len(falhas) == len(PURITY_PEDIDO) and not out:
        raise RuntimeError(f"wallhaven recusou ({', '.join(falhas)}); "
                           f"aperte R para tentar de novo")
    return out


def thumb_path(w):
    # _lg no nome: o cache antigo era small/ (300px) e nao pode ser reusado
    return CACHE_DIR / f"{w['id']}_lg.jpg"


def thumb_path_legacy(w):
    return CACHE_DIR / f"{w['id']}.jpg"


def local_thumb_path(f):
    """Cache em disco da miniatura local, invalido por mtime+bytes.

    Decodificar as 29 imagens da pasta mede 7,1 s (sao PNG de ate 15 MB /
    5120x2880). Guardar a versao 384px como JPEG faz a segunda abertura ser
    quase instantanea, sem depender de o PNG continuar no mesmo lugar.
    """
    try:
        st = f.stat()
        key = f"{f.stat().st_mtime_ns}-{st.st_size}"
    except OSError:
        return None
    h = __import__("hashlib").sha1(
        ("v2-%dx%d-" % (DECODE_W, DECODE_H) + str(f) + key).encode("utf-8", "replace")).hexdigest()[:20]
    return CACHE_DIR / "local" / f"{h}.jpg"


def fetch_thumb(w):
    dest = thumb_path(w)
    if dest.exists() and dest.stat().st_size > 1000:
        return dest
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    # migracao preguicosa: apaga o small/ antigo para nao ocupar disco
    # (eram ~150MB em milhares de arquivos)
    try:
        thumb_path_legacy(w).unlink(missing_ok=True)
    except OSError:
        pass
    wid = w["id"]
    for tmpl in (THUMB, THUMB.replace("/lg/", "/small/")):
        try:
            req = urllib.request.Request(tmpl.format(p=wid[:2], i=wid),
                                         headers={"User-Agent": "wallp/1.0"})
            with urllib.request.urlopen(req, timeout=15) as r:
                dest.write_bytes(r.read())
            return dest
        except (urllib.error.URLError, TimeoutError, OSError):
            continue
    return None


def fetch_full(w):
    dest = CACHE_DIR / f"{w['id']}{pathlib.Path(w['path']).suffix}"
    if dest.exists() and dest.stat().st_size > 1000:
        return dest
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(_get_bytes(w["path"], timeout=180))
    return dest


def _get_bytes(url, timeout):
    """Baixa uma URL inteira. Sem limite de tamanho: um PNG 4K+ passa
    facil de 100 MB -- e o chamador que decide onde vai parar."""
    req = urllib.request.Request(
        url, headers={"User-Agent": "wallp/1.0", "Referer": "https://wallhaven.cc/"}
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def unique_path(folder, stem, suffix):
    """wallhaven-abc.jpg, ou -1, -2... se ja existir. Nunca sobrescreve."""
    dest = folder / f"{stem}{suffix}"
    if not dest.exists():
        return dest
    i = 1
    while True:
        cand = folder / f"{stem}-{i}{suffix}"
        if not cand.exists():
            return cand
        i += 1


def download_wallpaper(w, folder):
    """Baixa o original para a pasta, com sufixo se o nome ja existir."""
    dest = unique_path(folder, f"wallhaven-{w['id']}",
                       pathlib.Path(w["path"]).suffix)
    dest.write_bytes(_get_bytes(w["path"], timeout=180))
    return dest


