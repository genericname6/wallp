class DaemonPool:
    """Pool de N threads daemon, para as miniaturas.

    ThreadPoolExecutor NAO serve aqui: o modulo concurrent.futures.threads
    registra um atexit que faz join em todas as workers, entao o processo
    espera o download terminar. Medido: 8,2 s para sair com 6 tarefas de 8 s,
    e nao ha como evitar -- shutdown(wait=False, cancel_futures=True) so
    cancela o que ainda nao comecou.

    Com threads daemon o interpretador nao espera: sair e imediato. O limite
    de 6 continua valendo, para nao abrir 130 conexoes contra o CDN.
    """

    def __init__(self, n=6):
        self._q = queue.Queue()
        self._lock = threading.Lock()
        self._started = 0
        self.n = n

    def submit(self, fn, *args):
        with self._lock:
            if self._started < self.n:
                self._started += 1
                threading.Thread(target=self._worker, daemon=True,
                                 name=f"wallp-thumb-{self._started}").start()
        self._q.put((fn, args))

    def _worker(self):
        while True:
            fn, args = self._q.get()
            try:
                fn(*args)
            except Exception:  # noqa: BLE001  # nunca matar a thread do pool
                pass


