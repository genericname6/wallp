            box.append(self.rot_info)

            sep = Gtk.Separator()
            sep.set_margin_top(4)
            box.append(sep)

            self.chk_boot = Gtk.CheckButton(label="Iniciar no boot (systemd)")
            self.chk_boot.connect("toggled", self.on_boot_toggle)
