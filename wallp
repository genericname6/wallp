  wallp                     abre a janela
  wallp --rotate            so a rotacao, sem janela (para o systemd)
  wallp --key <APIKEY>      grava a key em ~/.config/wallp/config.json (0600)
  wallp --pasta <caminho>   grava a pasta
  wallp --boot on|off       instala/desinstala a rotacao no boot
  wallp --status            mostra o estado
"""


def main():
    cfg = load_config()
    argv = sys.argv[1:]

    if "--help" in argv or "-h" in argv:
        print(USAGE)
        return 0

    if "--rotate" in argv:
        return run_headless(cfg)

    if "--key" in argv:
        i = argv.index("--key")
        if i + 1 >= len(argv):
            print(USAGE, file=sys.stderr)
            return 2
        cfg["key"] = argv[i + 1]
        save_config(cfg)
        print(f"key salva em {CONFIG_FILE} (0600)")
        return 0

    if "--pasta" in argv:
        i = argv.index("--pasta")
        if i + 1 >= len(argv):
            print(USAGE, file=sys.stderr)
            return 2
        cfg["folder"] = argv[i + 1]
        save_config(cfg)
        print(f"pasta salva: {cfg['folder']}")
        return 0

    if "--boot" in argv:
        i = argv.index("--boot")
        if i + 1 >= len(argv) or argv[i + 1] not in ("on", "off"):
            print(USAGE, file=sys.stderr)
            return 2
        boot_enable(cfg) if argv[i + 1] == "on" else boot_disable(cfg)
        print(f"boot: {boot_status()}")
        return 0

    if "--status" in argv:
        print(f"pasta     : {cfg['folder'] or '(vazia)'}")
        print(f"imagens   : {len(scan_folder(cfg['folder']))}")
        print(f"view      : {cfg['view']}")
        print(f"rotacao   : {'ligada' if cfg['rotate'] else 'desligada'} "
              f"a cada {human_time(cfg['interval'])}")
        print(f"boot      : {boot_status()}")
        print(f"key       : {'configurada' if cfg['key'] else 'ausente'}")
        return 0

    # ---- interface
    Win = build_gui()
    from gi.repository import Gtk  # so aqui que existe janela

    app = Gtk.Application(application_id=APP_ID)
    holder = {}

    def on_activate(a):
        nonlocal holder
        if "win" not in holder:
            holder["win"] = Win(a, cfg)
        holder["win"].present()

    app.connect("activate", on_activate)
    return app.run([])


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
