def load_config():
    cfg = dict(DEFAULT_CFG)
    try:
        data = json.loads(CONFIG_FILE.read_text())
        # JSON valido pode ainda ser tipo errado: [1,2] quebrava o app num
        # TypeError nao coberto pelo except
        if isinstance(data, dict):
            cfg.update(data)
    except (OSError, ValueError, TypeError):
        pass
    # normaliza o que o codigo consome como numero
    try:
        cfg["interval"] = max(0, int(cfg["interval"]))
    except (TypeError, ValueError):
        cfg["interval"] = DEFAULT_CFG["interval"]
    if cfg.get("unit") not in ("s", "min"):
        cfg["unit"] = "s"
    if cfg.get("view") not in ("list", "grid"):
        cfg["view"] = "list"
    # a key do ambiente NUNCA vai para o arquivo: ela existe para poder
    # rodar sem credencial em disco. A do disco e a ultima coisa gravada,
    # entao o save_config reescreve por cima dela.
    if env := os.environ.get("WALLP_KEY"):
        cfg["key"] = env
        cfg["_key_from_env"] = True
    return cfg


def save_config(cfg):
    """Grava de forma atomica, com 0600 desde o primeiro instante.

    Resolve tres problemas medidos:
      - write_text() truncava antes de escrever: energia cortada no meio
        deixava JSON invalido e o load_config engolia o erro em silencio
        (medido: 538 leituras de arquivo vazio em 300 escritas)
      - o chmod 0600 vinha DEPOIS do write, deixando a key world-readable
        por ~ms (medido: 0644 observado por leitor concorrente)
      - os.replace e atomico: ou o arquivo antigo inteiro, ou o novo inteiro

    E nao persiste a key que veio de WALLP_KEY: ela fica so na memoria.
    """
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    out = {k: v for k, v in cfg.items() if k != "_key_from_env"}
    if out.get("key") == os.environ.get("WALLP_KEY"):
        # leia de volta a key do disco, para nao trocar a do ambiente por ela
        try:
            previa = json.loads(CONFIG_FILE.read_text())
            if previa.get("key"):
                out["key"] = previa["key"]
            else:
                out.pop("key", None)
        except (OSError, ValueError, TypeError):
            out.pop("key", None)

    fd, tmp = tempfile.mkstemp(dir=str(CONFIG_DIR), prefix=".wallp-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(out, indent=2) + "\n")
            f.flush()
            os.fsync(f.fileno())      # garante que chegou ao disco
        os.chmod(tmp, 0o600)          # 0600 ANTES de existir no lugar final
        os.replace(tmp, CONFIG_FILE)  # <- atomico
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


