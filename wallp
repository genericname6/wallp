        def _restore_interval(self):
            """Repoe o intervalo sem disparar save_config.

            Antes, o spin e o dropdown ja estavam conectados: ajustar um
            disparava on_interval_changed, que salvava e reiniciava a
            contagem. E como o dropdown era setado ANTES do valor, o
            notify::selected usava o valor antigo do spin -- "2 min" virava
            "60 min" no disco (medido).
            """
            unit = self.cfg.get("unit", "s")
            iv = int(self.cfg.get("interval", 300) or 300)
            # silencia os sinais durante a restauracao
            self.spin.handler_block_by_func(self.on_interval_changed)
            self.unit_dd.handler_block_by_func(self.on_interval_changed)
            try:
                if unit == "min":
                    self.unit_dd.set_selected(1)
                    self.spin.set_value(max(1, min(1440, round(iv / 60))))
                else:
                    self.unit_dd.set_selected(0)
                    self.spin.set_value(max(1, min(1440, iv)))
            finally:
                self.spin.handler_unblock_by_func(self.on_interval_changed)
                self.unit_dd.handler_unblock_by_func(self.on_interval_changed)

        # ---------------- status / sync
        def say(self, msg, warn=False):
            _trace(f"STATUS: {msg}")
            self.status.set_label(msg)
            self.status.remove_css_class("warning")
            if warn:
                self.status.add_css_class("warning")

        def sync_rotate_ui(self):
            on = self.rotator.active
            self.chk_rotate.set_active(on)
            self.chk_boot.set_active(bool(self.cfg.get("boot")))
            self.chk_rotate.set_sensitive(self.rotator.available())
            n = len(self.rotator.files)
            if n:
                self.rot_info.set_text(f"{n} imagem(ns) na pasta · proxima: "
                                       f"{self.rotator.next_name() or '-'}")
            else:
                self.rot_info.set_text("pasta sem imagens: nada para rotacionar")
            self.on_rot_tick(self.rotator)

        def on_rot_tick(self, rot):
            if rot.active and rot.interval > 0:
                prog = 1 - (rot.remaining / rot.interval)
                self.clock.set_state(True, prog)
                self.countdown.set_text(f"proxima em {human_time(rot.remaining)}")
            elif rot.active:
                self.clock.set_state(True, 0.0)
                self.countdown.set_text("intervalo 0: aplica na mao (N)")
            else:
                self.clock.set_state(False, 0.0)
                self.countdown.set_text("rotacao parada")

        def on_rotated(self, f):
            GLib.idle_add(self.say, f"rotado: {f.name}")
            GLib.idle_add(self.sync_rotate_ui)

        # ---------------- handlers
        def on_rotate_toggle(self, btn):
            if btn.get_active() != self.rotator.active:
                self.rotator.toggle()
            self.cfg["rotate"] = self.rotator.active
            save_config(self.cfg)
            self.sync_rotate_ui()

        def on_interval_changed(self, *_):
            v = self.spin.get_value()
            secs = int(v * 60) if self.unit_dd.get_selected() == 1 else int(v)
            # nao grava a cada entalhe da roda do mouse: so quando o valor
            # realmente mudou de verdade
            if secs == self.cfg.get("interval") and self.rotator.interval == secs:
                return
            self.cfg["interval"] = max(1, secs)
            self.cfg["unit"] = "min" if self.unit_dd.get_selected() == 1 else "s"
            save_config(self.cfg)
            self.rotator.set_interval(max(1, secs))
            self.on_rot_tick(self.rotator)

        def on_boot_toggle(self, btn):
            if btn.get_active():
                boot_enable(self.cfg)
            else:
                boot_disable(self.cfg)
            self.say(f"boot: {boot_status()}")

        def on_next(self):
            if not self.rotator.files:
                self.say("pasta sem imagens", warn=True)
                return
            # atalho explicito de rotacao: nao desliga a rotacao
            name = self.rotator.next()
            self.say(f"aplicado: {name}" if name else "falhou", warn=name is None)

        def on_view_toggle(self, btn):
            mode = "grid" if btn.get_active() else "list"
            if mode == self.stack.get_visible_child_name():
                return
            self.cfg["view"] = mode
            save_config(self.cfg)
            self.stack.set_visible_child_name(mode)   # rebuild le o modo novo
            self.rebuild()

        def rebuild(self):
            """Redesenha tudo no container do modo atual.

            Inverter o Stack sozinho nao move nada: cada item foi criado num
            ListBox ou num Grid conforme o modo da hora. Entao juntamos tudo
            Numa lista unica, limpamos e recriamos.

            A ordem de exibicao e sempre local -> web, independente do modo.
            """
            # junta tudo sem repetir: o mesmo item pode estar em rows E em
            # grid_items se algum caminho antigo nao limpou
            merged, seen = [], set()
            for src in (list(self.rows.values()) + list(self.grid_items.values())):
                if id(src) not in seen:
                    seen.add(id(src))
                    merged.append(src)

            ordered = ([i for i in merged if i["kind"] == "local"]
                       + [i for i in merged if i["kind"] == "web"])

            self.clear()
            for it in ordered:
                badge = it.get("badge") or None
                if it["kind"] == "local":
                    badge = None
                self.add_item(self._pix_for(it), it.get("label", ""),
                              it.get("sub", ""), badge, it)
            if self.stack.get_visible_child_name() == "grid":
                self.resize_grid()      # posiciona tudo de uma vez
            return len(ordered)

        def on_key(self, _c, keyval, _k, _m, _state=None):
            if keyval in (ord("R"), ord("r")):
                self.load_web()
            elif keyval in (ord("V"), ord("v")):
                self.view_btn.set_active(not self.view_btn.get_active())
            elif keyval in (ord("N"), ord("n")):
                self.on_next()
            elif keyval == ord("q") and _m & 4:  # Ctrl+Q
                self.quit_app()
            else:
                return False
            return True

        def quit_app(self):
            self.rotator.stop()
            if self._tray:
                GLib.idle_add(self._tray.hide)
            self.get_application().quit()

        def on_close(self, *_):
            # fechar esconde em vez de sair, para a rotacao continuar
            if self.cfg.get("rotate") or self._tray:
                self.say("fechado, mas a rotacao continua · rode  wallp  para reabrir")
                self.set_visible(False)
                self._show_tray()
                return True
            self.quit_app()
            return False

        # ---------------- bandeja
        def _show_tray(self):
            """Bandeja: so funciona com a extensao AppIndicator do GNOME.

            Este codigo era GTK3 puro e nunca rodou: AppIndicator3 exige o
            namespace Gtk 3.0, que conflita com o Gtk 4.0 ja carregado
            (ImportError), e Gtk.Menu/MenuItem/CheckMenuItem nem existem no
            GTK4. Reescrito com Gio.Menu + Gtk.PopoverMenu, que sao as APIs
            atuais e funcionam com a extensao instalada.

            Sem a extensao, _tray fica None e a janela continua escondida --
            nesse caso o status diz como reabrir (rode `wallp`).
            """
            if self._tray:
                self._tray.set_status("wallp")
                return
            if not self._appindicator_ok():
                return

            menu = Gio.Menu()
            item_show = Gio.MenuItem.new("Mostrar wallp", None)
            item_show.set_action_and_target_value("win.show", None)
            menu.append_item(item_show)
            item_next = Gio.MenuItem.new("Próximo wallpaper", None)
            item_next.set_action_and_target_value("win.next", None)
            menu.append_item(item_next)
            menu.append_section(None, Gio.Menu.new())
            item_rot = Gio.MenuItem.new("Trocar automaticamente", None)
            item_rot.set_action_and_target_value("win.rotate", None)
            menu.append_item(item_rot)
            item_quit = Gio.MenuItem.new("Sair", None)
            item_quit.set_action_and_target_value("app.quit", None)
            menu.append_item(item_quit)

            try:
                gi.require_version("AyatanaAppIndicator3", "0.1")
                from gi.repository import AyatanaAppIndicator3 as AI
            except (ValueError, ImportError):
                try:
                    gi.require_version("AppIndicator3", "0.1")
                    from gi.repository import AppIndicator3 as AI
                except (ValueError, ImportError):
                    return

            icon = ICON_NAME
            theme = Gtk.IconTheme.get_for_display(self.get_display())
            if not theme.has_icon(icon):
                icon = "preferences-system-time-symbolic"
            try:
                ind = AI.Indicator.new(
                    "wallp", icon, AI.IndicatorCategory.APPLICATION_STATUS)
            except Exception:  # noqa: BLE001
                return
            ind.set_menu(menu)
            self._tray = ind

        def _appindicator_ok(self):
            """Registra as acoes que a bandeja dispara, uma vez so."""
            if getattr(self, "_actions_ok", False):
                return True
            self._actions_ok = True
            app = self.get_application()
            for name, cb in (("show", self._tray_show),
                             ("next", self.on_next),
                             ("rotate", self._tray_toggle)):
                try:
                    a = Gio.SimpleAction.new(name, None)
                    a.connect("activate", lambda _a, _p, cb=cb: cb())
                    app.add_action(a)
                except Exception:  # noqa: BLE001
                    pass
            return True

        def _tray_show(self):
            self.set_visible(True)
            self.present()

        def _tray_toggle(self):
            self.chk_rotate.set_active(not self.rotator.active)

            # ---------------- lista / grade
        def clear(self):
            for row in self.rows:
                self.listbox.remove(row)
            for h in self.headers:
                self.listbox.remove(h)
            for cell in self.grid_items:
                # so remove o que foi realmente anexado: entre o add_item e
                # o resize_grid a celula esta registrada mas ainda sem pai,
                # e o GTK reclama com um gtk_grid_remove assertion
                if cell.get_parent() is not None:
                    self.grid.remove(cell)
            self.rows.clear()
            self.headers.clear()
            self.grid_items.clear()
            self.web_refs.clear()
            self._ncols = GRID_COLS_DEFAULT
            self._cell_geom = None
            self._laid_out = -1

        def _relayout(self):
            """Anexa TODAS as celulas em ordem de insercao, com o _ncols atual.

            Antes, so as celulas em _pending eram posicionadas: as ja
            anexadas ficavam presas no ncols de quando entraram. Como os
            locais entram primeiro (antes da janela ter largura medida) e a
            web chega depois, a grade virava duas grades sobrepostas -- os
            locais em 3 colunas finas a esquerda e a web em 6 no resto.
            """
            n = self._ncols
            for pos, cell in enumerate(list(self.grid_items)):
                if cell.get_parent() is self.grid:
                    self.grid.remove(cell)
                self.grid.attach(cell, pos % n, pos // n, 1, 1)

        def clear_web(self):
            """Remove as linhas da web e seu cabecalho, preservando as locais."""
            # na grade qualquer remocao desloca as posicoes: reconstroi
            if self.stack.get_visible_child_name() == "grid":
                self.rebuild()
                return
            for widget, _c in self.web_refs:
                self.listbox.remove(widget)
                self.rows.pop(widget, None)
            self.web_refs.clear()
            # o cabecalho "Wallhaven 18+" e das web: sai junto
            for h in [h for h in self.headers if h.is_web_header]:
                self.listbox.remove(h)
                self.headers.remove(h)

        def add_header(self, text, is_web=False):
            # registra em self.headers: antes os cabecalhos nao entravam em
            # nenhuma lista e clear() nunca os removia, entao eles se
            # acumulavam a cada R (2 -> 12 cabecalhos em 10 refreshes)
            h = Header(text, is_web)
            self.listbox.append(h)
            self.headers.append(h)

        def add_item(self, pixbuf, title, subtitle, badge, item):
            """Coloca o item no container visivel e o registra.

            title/subtitle/badge sao guardados no proprio item para que o
            rebuild (troca lista<->grade) nao perca o texto.
            """
            item["label"] = title
            item["sub"] = subtitle
            item["badge"] = badge
            if pixbuf is not None:
                item["_pb"] = pixbuf      # sobrevive a troca lista<->grade
            if self.stack.get_visible_child_name() == "grid":
                cell = GridCell(pixbuf, badge)
                cell.item = item
                # nao anexa aqui: resize_grid()/_relayout() posiciona tudo
                # de uma vez no fim do lote, com um ncols so
                self.grid_items[cell] = item
                if item["kind"] == "web":
                    self.web_refs.append((cell, self.grid))
                return cell
            row = Row(pixbuf, title, subtitle, badge)
            row.item = item
            self.listbox.append(row)
            self.rows[row] = item
            if item["kind"] == "web":
                self.web_refs.append((row, self.listbox))
            return row

        def resize_grid(self):
            """Celulas em 21:9 (mais larga que alta), colunas responsivas.

            Primeiro decide quantas colunas cabem na largura, depois encolhe
            a celula (em largura e altura, sempre no 21:9) ate caberem as
            linhas que cabem na altura. Isso evita a rolagem enorme.
            """
            # largura real da grade. NAO usar max(160, ...): quando
            # get_width() devolve 0 (janela ainda nao alocada) o clamp
            # transformava 0 em 160, e a formula calculava 6 colunas de 6px
            # que ficavam travadas -- a grade so se ajustava quando o
            # usuario clicava no toggle de view.
            w = self.get_width() or 0
            h = self.get_height() or 0
            if w <= 0 or h <= 0:
                # ainda nao alocada: usa a largura real do stack, que ja
                # tem o tamanho do viewport, e nao o clamp de 160
                w = self.stack.get_width() or 0
                h = self.stack.get_height() or 0
            if w <= 0 or h <= 0:
                return self._ncols, 0, 0
            avail_w = max(160, w - 40)
            avail_h = max(120, h - 190)
            n = len(self.grid_items)
            if not n:
                return 0, 0, 0

            # Heuristica: usa a largura toda, mas sem celulas gigantes.
            # Sobe de colunas enquanto a celula ficar grande o bastante para
            # o wallpaper ser reconhecivel; a ultima coluna que cabe E a que
            # vence. Com GRID_CELL_MAX como teto, para nao sobrar vao vazio.
            ncols = 2
            cw = (avail_w - 6) / 2
            for c in range(2, GRID_COLS_MAX + 1):
                cand = (avail_w - (c - 1) * 6) / c
                if cand < GRID_CELL_MIN:
                    break                       # pequena demais: para aqui
                if cand > GRID_CELL_MAX:
                    continue                    # ainda cabe mais gente
                ncols, cw = c, cand
            cw = min(cw, GRID_CELL_MAX)
            # se a melhor celula ainda for enorme, preferimos 1 coluna a mais
            # em vez de deixar metade da tela vazia
            while ncols < GRID_COLS_MAX and cw > GRID_CELL_MAX:
                ncols += 1
                cw = min(cw, (avail_w - (ncols - 1) * 6) / ncols)
            ch = int(cw / GRID_RATIO)

            # saida antecipada: se nada mudou e todas as celulas ja estao
            # anexadas, nao toca nos widgets. Sem isso, cada tick de resize
            # fazia detach+attach de todas as celulas mesmo sem mudanca, e
            # durante um arraste isso empilhava layouts atras do compositor.
            if (ncols, int(cw), ch) == self._cell_geom and n == self._laid_out:
                if all(c.get_parent() is self.grid for c in self.grid_items):
                    return ncols, int(cw), ch
            for cell in self.grid_items:
                # so altura, sem largura: a largura vem do hexpand (divisao
                # igual do viewport). Com largura minima a grade pedia
                # ~1350px de min-width, o ScrolledWindow propagava e a janela
                # nao encolhia -- ver GridCell.
                cell.set_size_request(-1, ch)
            self._ncols = ncols
            self._cell_geom = (ncols, int(cw), ch)
            self._laid_out = n
            self._relayout()                      # reposiciona com o ncols novo
            return ncols, int(cw), ch

        # -- local
        def _add_local_file(self, f):
            """Adiciona UM arquivo local a lista. Usado pelo load_local e
            pelo _adopt_new (quando um download chega na pasta)."""
            item = {"kind": "local", "path": str(f)}
            pb = self._load_local(f)          # cache de disco; None = decodifica depois
            if pb is not None:
                item["_pb"] = pb
            else:
                POOL.submit(self._local_worker, f, item)
            try:
                kb = f.stat().st_size // 1024
            except OSError:
                kb = 0
            return self.add_item(pb, f.name, f"{kb} KB", None, item)

        def load_local(self, folder):
            files = scan_folder(folder)
            if not files:
                return 0
            self.add_header(f"Local  ·  {len(files)} imagem(ns) em {folder}")
            for f in files:
                self._add_local_file(f)
            return len(files)

        def _adopt_new(self, folder):
            """Traz para a lista os arquivos que apareceram na pasta depois
            do load -- e o que acontece quando um download termina. Nao
            recarrega nada: so anexa o que ainda nao esta la."""
            have = {it["path"] for it in
                    {**self.rows, **self.grid_items}.values()
                    if it["kind"] == "local"}
            added = 0
            for f in scan_folder(folder):
                if str(f) not in have:
                    self._add_local_file(f)
                    added += 1
            if not added:
                return 0
            # se a pasta estava vazia nao havia cabecalho "Local"
            if not any(not h.is_web_header for h in self.headers):
                self.add_header(f"Local  ·  {len(scan_folder(folder))} imagem(ns) em {folder}")
            if self.stack.get_visible_child_name() == "grid":
                self.resize_grid()
            self.rotator.folder = str(folder)
            self.rotator.rescan()
            self.sync_rotate_ui()
            return added

        def _load_local(self, f):
            """Miniatura local do cache em disco, ou None se ainda nao existe."""
            p = local_thumb_path(f)
            if p is None or not p.exists():
                return None
            try:
                return GdkPixbuf.Pixbuf.new_from_file_at_scale(str(p), DECODE_W, DECODE_H, True)
            except GLib.Error:
                return None

        def _local_worker(self, f, item):
            """Decodifica fora da thread da UI e grava o cache de disco."""
            p = local_thumb_path(f)
            pb = self._decode_local(f, p)
            if pb is None:
                return
            GLib.idle_add(self._set_item_thumb, item, pb)

        def _save_thumb_atomic(self, pb, dest):
            """Salva a miniatura via .tmp + os.replace.

            Sem isso, dois workers do mesmo arquivo (um disparado por
            _pix_for durante um rebuild, antes do primeiro terminar) escrevem
            no mesmo caminho e um JPEG pela metade passa na validacao de
            tamanho (>1000 bytes) como se estivesse inteiro.
            """
            tmp = dest.with_name(f".{dest.name}.{os.getpid()}"
                                 f".{threading.get_ident()}.tmp")
            try:
                pb.savev(str(tmp), "jpeg", [], [])
                os.replace(tmp, dest)
            except (GLib.Error, OSError):
                try:
                    tmp.unlink()
                except OSError:
                    pass

        def _decode_local(self, f, dest):
            """Abre a imagem local, com fallback quando o glycin recusa.

            O glycin (loader do GNOME 50) falha em alguns PNGs 5120x2880 com
            "InternalEditorError" -- 10 das 29 imagens da pasta. Nesses casos
            o ImageMagick gera a miniatura, que e so 4 KB.
            """
            if dest is not None:
                dest.parent.mkdir(parents=True, exist_ok=True)
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(f), DECODE_W, DECODE_H, True)
                if dest is not None and not dest.exists():
                    self._save_thumb_atomic(pb, dest)
                return pb
            except GLib.Error:
                pass

            # fallback: imagem magick
            if dest is None:
                return None
            tool = next((t for t in ("magick", "convert")
                         if __import__("shutil").which(t)), None)
            if not tool:
                return None
            try:
                subprocess.run(
                    [tool, str(f), "-resize", f"{DECODE_W}x{DECODE_H}", str(dest)],
                    capture_output=True, timeout=60, check=True)
            except (subprocess.SubprocessError, OSError):
                return None
            try:
                return GdkPixbuf.Pixbuf.new_from_file_at_scale(str(dest), DECODE_W, DECODE_H, True)
            except GLib.Error:
                return None

        # -- web
        def load_web(self, keep_status=None):
            # trava a busca: sem isso, 3 R seguidos empilham 3 lotes
            # (medido: 89 -> 209 linhas) porque cada _web_done anexa sem limpar
            if self._web_busy:
                return
            self.clear_web()
            key = self.entry_key()
            if not key:
                # nao sobrescreve a mensagem da pasta: era ela que explicava
                # por que a lista local estava vazia
                self.say(keep_status or
                         "sem API key: use  wallp --key <APIKEY>  ou  WALLP_KEY",
                         warn=not keep_status)
                return
            self._web_busy = True
            self.say("buscando wallpapers 18+ no wallhaven...")
            threading.Thread(target=self._web_worker, args=(key,), daemon=True).start()

        def entry_key(self):
            return load_config().get("key", "")

        def _web_worker(self, key):
            try:
                GLib.idle_add(self._web_done, fetch_web(key), None)
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self._web_done, [], str(e))

        def _web_done(self, data, err):
            self._web_busy = False
            if err:
                self.say(f"web: {err}", warn=True)
                return False
            if not data:
                # fetch_web levanta excecao quando a rede falha; chegar aqui
                # com [] e sem erro significa que a API respondeu mas o
                # filtro 18+ removeu tudo (o param purity do servidor nao
                # filtra nada, entao as vezes o lote vem sem nsfw/sketchy)
                self.say("web: o lote veio sem nenhum nsfw/sketchy (tente R)",
                         warn=True)
                return False

            if self.stack.get_visible_child_name() == "list":
                self.add_header(f"Wallhaven 18+  ·  {len(data)} wallpaper(s)", is_web=True)
            for w in data:
                item = {"kind": "web", "w": w}
                w["_item_ref"] = item          # o worker acha o item por ele
                pb = self._load_thumb(w)
                if pb is None:
                    POOL.submit(self._thumb_worker, w)
                self.add_item(pb, w["id"],
                              f"{w.get('resolution', '?')} · {w.get('file_size', 0) // 1024} KB",
                              w.get("purity", ""), item)
            if self.stack.get_visible_child_name() == "grid":
                self.resize_grid()
            n_sfw = sum(1 for w in data if w["purity"] == "nsfw")
            self.say(f"{len(data)} da web ({n_sfw} nsfw, {len(data) - n_sfw} sketchy)"
                     f" · R sorteia · V troca a view")
            return False

        def _load_thumb(self, w):
            tp = thumb_path(w)
            if not tp.exists():
                return None
            try:
                return GdkPixbuf.Pixbuf.new_from_file_at_scale(str(tp), DECODE_W, DECODE_H, True)
            except GLib.Error:
                return None

        def _thumb_worker(self, w):
            p = fetch_thumb(w)
            if not p:
                return
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(p), DECODE_W, DECODE_H, True)
            except GLib.Error:
                return
            GLib.idle_add(self._set_item_thumb, w.get("_item_ref"), pb)

        def _set_item_thumb(self, item, pb):
            """Pinta a miniatura assim que ela recebe, sem travar a UI.

            Recebe o proprio item e compara com `is`, nunca com id(item): o
            Python recicla endereco de dict e a auditoria mediu 48% dos dicts
            de um lote novo caindo no endereco de um dict morto do anterior.
            Com id(), um worker atrasado pintava a celula errada e ainda
            gravava o _pb errado, que persistia ate o proximo rebuild.
            """
            if item is None:
                return False
            for widget, it in {**self.rows, **self.grid_items}.items():
                if it is item:
                    item["_pb"] = pb
                    if isinstance(widget, GridCell):
                        widget.set_pixbuf(pb)
                    else:
                        widget.get_child().get_first_child().set_paintable(paintable(pb))
                    break
            return False

        # -- acoes
        def load(self):
            folder = self.entry.get_text().strip()
            self.cfg["folder"] = folder
            save_config(self.cfg)
            self.clear()

            n_local = self.load_local(folder)
            # no modo grade as celulas so sao anexadas por resize_grid;
            # sem esta chamada a grade ficava em branco ao apertar "Abrir"
            if self.stack.get_visible_child_name() == "grid":
                self.resize_grid()
            # a mensagem de pasta vazia nao pode ser sobrescrita em seguida
            # por "sem API key" (a causa real sumia da tela)
            msg = (f"{n_local} local(is)" if n_local
                   else f"pasta vazia ou invalida: {folder or '(sem caminho)'}")

            self.rotator.folder = folder
            self.rotator.rescan()
            self.sync_rotate_ui()
            if self.rotator.active and not self.rotator.files:
                self.rotator.stop()
                self.cfg["rotate"] = False
                save_config(self.cfg)

            self.load_web(keep_status=msg)

        def on_activate(self, _lb, row):
            if item := self.rows.get(row):
                self.apply(item)

        def on_grid_click(self, gesture, n_press, x, y):
            if n_press != 1:
                return
            # pick() devolve o filho mais profundo (o Picture dentro do
            # Overlay), nao a celula. Sem subir ate o pai, o clique nunca
            # encontra o item e a grade fica sem resposta nenhuma.
            node = self.grid.pick(x, y, Gtk.PickFlags.DEFAULT)
            while node is not None and node not in self.grid_items:
                node = node.get_parent()
            if node is None:
                return
            if item := self.grid_items.get(node):
                self.apply(item)

        def _grid_item_at(self, x, y):
            """Acha a celula sob o cursor, subindo do filho mais profundo."""
            node = self.grid.pick(x, y, Gtk.PickFlags.DEFAULT)
            while node is not None and node not in self.grid_items:
                node = node.get_parent()
            return self.grid_items.get(node)

        def on_grid_rightclick(self, gesture, n_press, x, y):
            _trace(f"GESTO grade n_press={n_press} x={x:.0f} y={y:.0f}")
            if item := self._grid_item_at(x, y):
                _trace(f"ITEM grade kind={item.get('kind')}")
                self.show_ctx_menu(self.grid, x, y, item)
            else:
                _trace("ITEM grade: nada sob o cursor")

        def on_list_rightclick(self, gesture, n_press, x, y):
            _trace(f"GESTO lista n_press={n_press} x={x:.0f} y={y:.0f}")
            row = self.listbox.get_row_at_y(y)
            item = self.rows.get(row) if row is not None else None
            _trace(f"ITEM lista kind={(item or {}).get('kind')}")
            if item is not None:
                self.show_ctx_menu(self.listbox, x, y, item)

        def show_ctx_menu(self, widget, x, y, item):
            """Menu de botao direito. So abre nos itens da web.

            E um Popover comum com um Button ligado direto, de proposito:
            a versao anterior usava PopoverMenu+Gio.Menu, e a ligacao
            modelo->botao falhava em silencio (action-name None no
            GtkModelButton) -- o item aparecia sensivel, o clique nao
            disparava nada, sem erro nenhum. Aqui nao ha despacho de acao.
            """
            if item.get("kind") != "web":
                _trace("MENU: item local, sem menu (esperado)")
                return
            _trace(f"MENU abrindo id={item['w']['id']}")
            self._ctx_item = item
            self._close_pop()
            pop = Gtk.Popover()
            btn = Gtk.Button(label="Baixar para a pasta")
            btn.connect("clicked",
                        lambda _b: (pop.popdown(), self.on_download_action()))
            pop.set_child(btn)
            pop.set_parent(widget)
            # Gdk.Rectangle() ignora argumentos no construtor (vira 0,0,0,0
            # e o menu abria no lugar errado): preenche campo a campo
            at = Gdk.Rectangle()
            at.x, at.y, at.width, at.height = int(x), int(y), 1, 1
            pop.set_pointing_to(at)
            pop.connect("closed", lambda p: p.unparent())
            self._pop = pop
            pop.popup()

        def _close_pop(self):
            if self._pop is not None:
                try:
                    self._pop.popdown()
                except Exception:  # noqa: BLE001
                    pass
                self._pop = None

        def _pix_for(self, item):
            """Pixbuf do item. Fica preso ao proprio item, entao sobrevive a
            varias trocas de lista<->grade.

            Sem isso, cada clique redecodifica ~30 PNGs de ate 15 MB na thread
            da UI: 7,2 s de congelamento medidos, agora ~0,03 s.
            """
            pb = item.get("_pb")
            if pb is not None:
                return pb
            if item["kind"] == "local":
                pb = self._load_local(pathlib.Path(item["path"]))
                if pb is None:
                    POOL.submit(self._local_worker, pathlib.Path(item["path"]), item)
                    return None
            else:
                pb = self._load_thumb(item["w"])
                if pb is None:
                    POOL.submit(self._thumb_worker, item["w"])
            if pb is not None:
                item["_pb"] = pb
            return pb

        def apply(self, item):
            # sincroniza o indice: sem isso, clicar em img2 e depois apertar N
            # aplicava img0, porque o rotator nunca soube o que foi escolhido
            if self.rotator.files and item.get("kind") == "local":
                p = str(item["path"])
                if p in [str(f) for f in self.rotator.files]:
                    self.rotator.index = [str(f) for f in self.rotator.files].index(p)
            # escolha manual tem prioridade: se a rotacao estava ligando, ela
            # desliga de vez, senao o proximo tick sobrescreveria o clique
            if self.rotator.active:
                self.rotator.stop()
                self.cfg["rotate"] = False
                save_config(self.cfg)
                self.sync_rotate_ui()
                GLib.idle_add(self.say, "rotacao desligada (escolha manual)")
            if item["kind"] == "local":
                threading.Thread(target=self._apply_local, args=(item["path"],),
                                 daemon=True).start()
            else:
                threading.Thread(target=self._apply_web, args=(item["w"],),
                                 daemon=True).start()

        def _apply_local(self, path):
            GLib.idle_add(self.say, f"aplicado: {pathlib.Path(path).name}")
            try:
                set_wallpaper(path)
            except (subprocess.CalledProcessError, OSError) as e:
                GLib.idle_add(self.say, f"falhou: {e}", True)

        def on_download_action(self):
            """Botao direito > Baixar. So chega aqui com item da web."""
            _trace("ACAO download disparada")
            item = self._ctx_item
            self._ctx_item = None
            if not item or item.get("kind") != "web":
                return
            # resolve a pasta na thread principal: mexe no entry e no disco
            try:
                folder = self._resolve_folder()
            except OSError as e:
                self.say(f"falhou: {e}", True)
                return
            threading.Thread(target=self._download_web,
                             args=(item["w"], folder), daemon=True).start()

        def _resolve_folder(self):
            """Pasta do topo, ou a padrao. Cria se nao existir.

            Com o campo vazio, adota ~/Pictures/wallpapers: escreve no entry
            e salva, para a lista local passar a mostrar de onde veio.
            """
            typed = self.entry.get_text().strip()
            folder = pathlib.Path(typed or str(DEFAULT_FOLDER)).expanduser()
            _trace(f"PASTA entry={typed!r} destino={folder}")
            folder.mkdir(parents=True, exist_ok=True)
            if not typed:
                self.entry.set_text(str(folder))
                self.cfg["folder"] = str(folder)
                save_config(self.cfg)
            return folder

        def _download_web(self, w, folder):
            _trace(f"DOWNLOAD inicio id={w['id']}")
            GLib.idle_add(self.say, f"baixando {w['id']}...")
            try:
                dest = download_wallpaper(w, folder)
                _trace(f"DOWNLOAD ok {dest.name} {dest.stat().st_size}b")
            except Exception as e:  # noqa: BLE001
                _trace(f"DOWNLOAD falhou: {type(e).__name__}: {e}")
                GLib.idle_add(self.say, f"falhou: {e}", True)
                return
            GLib.idle_add(self._downloaded, dest, folder)

        def _downloaded(self, dest, folder):
            """Arquivo chegou: avisa onde salvou e anexa na lista local."""
            n = self._adopt_new(folder)
            self.say(f"baixado: {dest.name}  →  {folder}"
                     + ("" if n else " (ja estava na lista)"))
            return False

        def _apply_web(self, w):
            GLib.idle_add(self.say, f"baixando {w['id']}...")
            try:
                dest = fetch_full(w)
                GLib.idle_add(self.say, f"aplicado: {dest.name}")
                set_wallpaper(dest)
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self.say, f"falhou: {e}", True)

        def do_size_allocate(self, *a):  # noqa: N802
            Gtk.ApplicationWindow.do_size_allocate(self, *a)
            if self.stack.get_visible_child_name() != "grid":
                return
            w = self.get_width()
            if not w or abs(w - self._width) <= 4:
                return
            self._width = w
            # Debounce de borda FINAL: cancela o pendente e agenda um so,
            # 120ms depois da ultima mudanca. Antes era um loop que repetia
            # a cada 45ms enquanto a largura mudava + detach/attach de todas
            # as celulas a cada tick. Ao encolher, cada tick media a largura
            # ainda antiga (maior), calculava celulas grandes demais e a
            # grade pedia mais largura minima do que a janela tinha -- o
            # compositor brigava com o arraste e tudo travava. Para fora
            # (aumentar) o erro ia para o outro lado (celulas pequenas,
            # espaco vazio) e parecia normal. Agora: nenhum layout durante
            # o arraste, um so quando assentar.
            if self._resize_id:
                GLib.source_remove(self._resize_id)
            self._resize_id = GLib.timeout_add(120, self._deferred_resize)

        def _deferred_resize(self):
            """Um tiro so: recalcula com a largura ja assentada."""
            self._resize_id = None
            if self.stack.get_visible_child_name() != "grid":
                return False
            self._width = self.get_width() or self._width
            self.resize_grid()
            return False

    return Win


# --------------------------------------------------------------------------- main

USAGE = """uso:
  wallp                     abre a janela
  wallp --rotate            so a rotacao, sem janela (para o systemd)
  wallp --key <APIKEY>      grava a key em ~/.config/wallp/config.json (0600)
  wallp --pasta <caminho>   grava a pasta
  wallp --boot on|off       instala/desinstala a rotacao no boot
  wallp --status            mostra o estado
"""


def main():
    cfg = load_config()
    argv = sys.argv[1:]

    if "--help" in argv or "-h" in argv:
        print(USAGE)
        return 0

    if "--rotate" in argv:
        return run_headless(cfg)

    if "--key" in argv:
        i = argv.index("--key")
        if i + 1 >= len(argv):
            print(USAGE, file=sys.stderr)
            return 2
        cfg["key"] = argv[i + 1]
        save_config(cfg)
        print(f"key salva em {CONFIG_FILE} (0600)")
        return 0

    if "--pasta" in argv:
        i = argv.index("--pasta")
        if i + 1 >= len(argv):
            print(USAGE, file=sys.stderr)
            return 2
        cfg["folder"] = argv[i + 1]
        save_config(cfg)
        print(f"pasta salva: {cfg['folder']}")
        return 0

    if "--boot" in argv:
        i = argv.index("--boot")
        if i + 1 >= len(argv) or argv[i + 1] not in ("on", "off"):
            print(USAGE, file=sys.stderr)
            return 2
        try:
            if argv[i + 1] == "on":
                boot_enable(cfg)
            else:
                boot_disable(cfg)
        except RuntimeError as e:
            print(f"wallp: {e}", file=sys.stderr)
            return 1
        print(f"boot: {boot_status()}")
        return 0

    if "--status" in argv:
        print(f"pasta     : {cfg['folder'] or '(vazia)'}")
        print(f"imagens   : {len(scan_folder(cfg['folder']))}")
        print(f"view      : {cfg['view']}")
        print(f"rotacao   : {'ligada' if cfg['rotate'] else 'desligada'} "
              f"a cada {human_time(cfg['interval'])}")
        print(f"boot      : {boot_status()}")
        print(f"key       : {'configurada' if cfg['key'] else 'ausente'}")
        return 0

    # ---- interface
    Win = build_gui()
    from gi.repository import Gtk  # so aqui que existe janela

    app = Gtk.Application(application_id=APP_ID)
    holder = {}

    def on_activate(a):
        nonlocal holder
        if "win" not in holder:
            holder["win"] = Win(a, cfg)
        holder["win"].present()

    app.connect("activate", on_activate)
    return app.run([])


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
