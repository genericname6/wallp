            self.status.add_css_class("st")
            self.status.set_margin_bottom(4)
            root.append(self.status)

            self.set_child(root)

            self.rows = {}
            self.grid_items = {}
            self.web_refs = []   # (widget, container) so da web, p/ recarregar limpo
            self._width = 0
            self._tray = None
            self._pending = []       # celulas ainda nao posicionadas
            self._ncols = GRID_COLS_DEFAULT

            self.ctrl = Gtk.EventControllerKey()
            self.ctrl.connect("key-pressed", self.on_key)
            self.add_controller(self.ctrl)
            self.connect("close-request", self.on_close)

            if cfg.get("rotate"):
